{
  "name": "anicore",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/assets/uploads/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anicore",
      "database_id": "bed48c92-adbc-42ee-8365-427c6a203c3b",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "Anicore"
  }
}
