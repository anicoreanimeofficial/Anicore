{
  "name": "anicore",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/assets/uploads/*", "/health"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "anicore", "database_id": "PASTE_DATABASE_ID_HERE", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "anicore-uploads" }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": { "ENVIRONMENT": "production", "APP_NAME": "Anicore" }
}
